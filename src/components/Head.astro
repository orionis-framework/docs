---
import StarlightHead from '@astrojs/starlight/components/Head.astro';
import MermaidDiagrams from './MermaidDiagrams.astro';
import { getPageBySlug, getTranslations } from '../utils/documentation-menu.mjs';
import {
  defaultSEO,
  generateCanonicalURL,
  generateOGImageURL,
  generateSEODescription,
  generateTechArticleSchema,
} from '../utils/seo';

const route = Astro.locals.starlightRoute;
const { entry, lang, lastUpdated } = route;
const baseURL = Astro.site?.href || 'https://docs.orionis-framework.com';
const canonical = route.head.find(({ tag, attrs }) => tag === 'link' && attrs?.rel === 'canonical');
const currentURL = String(canonical?.attrs?.href || generateCanonicalURL(Astro.url.pathname, baseURL));
const nativeDescription = route.head.find(({ tag, attrs }) => tag === 'meta' && attrs?.name === 'description');
const description = String(nativeDescription?.attrs?.content || generateSEODescription(entry.data.description || '', lang));
const languageURL = (slug: string) => generateCanonicalURL(
  slug.replace(/\/+$/, '') + (new URL(currentURL).pathname.endsWith('/') ? '/' : ''),
  baseURL,
);
const ogImage = generateOGImageURL(baseURL);
const page = getPageBySlug(Astro.url.pathname);
const translations = page ? getTranslations(page.id) : [];

// Starlight supplies title, description, canonical, Open Graph and Twitter card metadata.
// Its default locale links assume matching slugs; this catalogue pairs pages by ID.
route.head = route.head.filter(({ tag, attrs }) =>
  !(tag === 'link' && attrs?.rel === 'alternate' && attrs?.hreflang)
);
for (const translation of translations) {
  route.head.push({
    tag: 'link',
    attrs: {
      rel: 'alternate',
      hreflang: translation.locale,
      href: languageURL(translation.slug),
    },
  });
}
const defaultTranslation = translations.find(({ locale }) => locale === 'en');
if (defaultTranslation) {
  route.head.push({
    tag: 'link',
    attrs: {
      rel: 'alternate',
      hreflang: 'x-default',
      href: languageURL(defaultTranslation.slug),
    },
  });
}

const extraMetadata = [
  { name: 'author', content: defaultSEO.en.author },
  { property: 'og:image', content: ogImage },
  { property: 'og:image:alt', content: `Orionis Framework — ${entry.data.title}` },
  { name: 'twitter:title', content: entry.data.title },
  { name: 'twitter:description', content: description },
  { name: 'twitter:image', content: ogImage },
  { name: 'twitter:image:alt', content: `Orionis Framework — ${entry.data.title}` },
];
for (const attrs of extraMetadata) {
  const key = 'name' in attrs ? 'name' : 'property';
  if (!route.head.some(({ tag, attrs: existing }) => tag === 'meta' && existing?.[key] === attrs[key])) {
    route.head.push({ tag: 'meta', attrs });
  }
}

const article = page ? generateTechArticleSchema({
  title: entry.data.title,
  description,
  url: currentURL,
  lang,
  dateModified: lastUpdated?.toISOString(),
}) : undefined;
// Escape markup so content cannot terminate the JSON-LD script element.
const structuredData = article ? JSON.stringify(article).replace(/</g, '\\u003c') : undefined;
---

<StarlightHead />
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JTQ7F09351"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-JTQ7F09351');
</script>
<MermaidDiagrams />

<link rel="preload" href="/fonts/titillium-web-400-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/titillium-web-600-latin.woff2" as="font" type="font/woff2" crossorigin />
{page && page.kind !== 'astro' && <link rel="preload" href="/fonts/jetbrains-mono-regular.woff2" as="font" type="font/woff2" crossorigin />}

{structuredData && <script type="application/ld+json" set:html={structuredData} />}

<script is:inline src="/js/global.js"></script>
