---
import { Icon } from '@astrojs/starlight/components';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import LanguageSelect from './LanguageSelect.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import NavigationIcon from './NavigationIcon.astro';
import { documentationNavigation, navigationSections } from '../utils/documentation-menu.mjs';

const { sidebar, lang } = Astro.locals.starlightRoute;
type SidebarEntry = (typeof sidebar)[number];
type SidebarLink = Extract<SidebarEntry, { type: 'link' }>;

function firstDescendantLink(items: SidebarEntry[]): SidebarLink | undefined {
  for (const item of items) {
    if (item.type === 'link') return item;
    const link = firstDescendantLink(item.entries);
    if (link) return link;
  }
}

function isActive(entry: SidebarEntry): boolean {
  return entry.type === 'link' ? entry.isCurrent : entry.entries.some(isActive);
}

const spanish = lang === 'es';
const locale = spanish ? 'es' : 'en';
const groups = new Map(navigationSections.map((section) => [section.id, section]));
const bands = new Map(documentationNavigation.bands.map((band) => [band.id, band]));
const entries = sidebar.map((entry) => {
  const firstLink = entry.type === 'group' && firstDescendantLink(entry.entries);
  const section = firstLink ? groups.get(firstLink.attrs['data-nav-group']) : undefined;
  if (entry.type === 'group' && !section) throw new Error(`Missing navigation metadata: ${entry.label}`);
  const subgroups = entry.type === 'group' && entry.entries.some((item) => item.type === 'group')
    ? entry.entries.map((item) => {
      if (item.type !== 'group') throw new Error(`Mixed grouped navigation: ${entry.label}`);
      const link = firstDescendantLink(item.entries);
      const id = link?.attrs['data-nav-subgroup'];
      if (!id) throw new Error(`Missing subgroup metadata: ${item.label}`);
      return { entry: item, id, active: isActive(item) };
    })
    : undefined;
  return { entry, section, subgroups };
});
---

<orionis-sidebar>
<div class="sidebar-heading">
  <p class="sidebar-kicker">{spanish ? 'Documentación' : 'Documentation'}</p>
  <p class="sidebar-caption">{spanish ? 'Desarrolla con Orionis' : 'Build with Orionis'}</p>
</div>

<a class="api-reference-link" href={spanish ? 'https://inspector.orionis-framework.com/es/' : 'https://inspector.orionis-framework.com/'}
  target="_blank" rel="noopener noreferrer"
  title={spanish ? 'Inspecciona y valida tus servidores MCP en el navegador' : 'Inspect and validate your MCP servers in the browser'}>
  <span class="resource-icon"><NavigationIcon name="mcp" /></span>
  <span class="resource-label">MCP Inspector</span>
  <Icon name="external" class="resource-external" size="0.875rem" />
</a>

<div class="sidebar-filter" hidden>
  <label for="navigation-filter">{spanish ? 'Filtrar menú' : 'Filter menu'}</label>
  <div class="sidebar-filter-field">
    <input id="navigation-filter" type="search" placeholder={spanish ? 'Buscar una guía…' : 'Find a guide…'}
      autocomplete="off" aria-controls="orionis-sidebar-tree" />
    <button type="button" data-clear-filter aria-label={spanish ? 'Limpiar filtro' : 'Clear filter'} hidden>
      <Icon name="close" size="1.25rem" />
    </button>
  </div>
  <p role="status" data-filter-status data-empty={spanish ? 'No se encontraron guías.' : 'No guides found.'}
    data-count={spanish ? 'Guías encontradas:' : 'Guides found:'}></p>
</div>

{/* Open state comes from the current route, without restoring past expanded groups. */}
<ul id="orionis-sidebar-tree" class="sidebar-tree top-level">
  {entries.map(({ entry, section, subgroups }, index) => {
    if (entry.type === 'group') {
      const startsBand = index === 0 || entries[index - 1].section?.band !== section.band;
      const active = isActive(entry);
      return (
        <li>
          {startsBand && <p class="sidebar-band" data-band-id={section.band}>{bands.get(section.band).title[locale]}</p>}
          <details class:list={['sidebar-section', { 'is-active': active }]}
            data-section-id={section.id} open={active}>
            <summary>
              <span class="section-icon"><NavigationIcon name={section.icon} /></span>
              <span class="section-label large">{entry.label}</span>
              <Icon name="right-caret" class="caret" size="1rem" />
            </summary>
            {subgroups ? (
              <ul class="sidebar-subgroups">
                {subgroups.map((subgroup) => (
                  <li>
                    <details class:list={['sidebar-subgroup', { 'is-active': subgroup.active }]}
                      data-subgroup-id={subgroup.id} data-section-id={section.id} open={subgroup.active}>
                      <summary>
                        <span class="subgroup-label">{subgroup.entry.label}</span>
                        <Icon name="right-caret" class="caret" size="0.875rem" />
                      </summary>
                      <SidebarSublist sublist={subgroup.entry.entries} nested />
                    </details>
                  </li>
                ))}
              </ul>
            ) : <SidebarSublist sublist={entry.entries} nested />}
          </details>
        </li>
      );
    }
    return (
      <li>
        <a href={entry.href} {...entry.attrs} aria-current={entry.isCurrent && 'page'}>
          <span class="resource-icon"><NavigationIcon name="api" /></span>
          <span class="resource-label">{entry.label}</span>
          <Icon name="external" class="resource-external" size="0.875rem" />
        </a>
      </li>
    );
  })}
</ul>

<div class="mobile-sidebar-controls md:sl-hidden">
  <p class="sidebar-preferences-title">{spanish ? 'Preferencias' : 'Preferences'}</p>
  <div class="mobile-preferences">
    <div><p>{spanish ? 'Tema' : 'Theme'}</p><ThemeSelect /></div>
    <div><p>{spanish ? 'Idioma' : 'Language'}</p><LanguageSelect /></div>
  </div>
  <a class="sidebar-github" href="https://github.com/orionis-framework">
    <Icon name="github" size="1.25rem" /> GitHub
  </a>
</div>
</orionis-sidebar>

<script>
  class OrionisSidebar extends HTMLElement {
    connectedCallback() {
      const filter = this.querySelector<HTMLElement>('.sidebar-filter')!;
      const input = filter.querySelector('input')!;
      const clear = filter.querySelector<HTMLButtonElement>('button')!;
      const status = filter.querySelector<HTMLElement>('[data-filter-status]')!;
      const tree = this.querySelector<HTMLUListElement>('.sidebar-tree')!;
      const sections = [...tree.querySelectorAll<HTMLDetailsElement>('.sidebar-section')];
      const disclosures = [...tree.querySelectorAll<HTMLDetailsElement>('details')];
      const savedOpen = new Map<HTMLDetailsElement, boolean>();
      const normalize = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
      const controller = new AbortController();
      this.cleanup = () => controller.abort();
      const options = { signal: controller.signal };

      filter.hidden = false;
      input.addEventListener('input', () => {
        const query = normalize(input.value.trim());
        const filtering = this.hasAttribute('data-filtering');
        if (query && !filtering) disclosures.forEach((group) => savedOpen.set(group, group.open));
        this.toggleAttribute('data-filtering', Boolean(query));
        clear.hidden = !query;
        // A matching ancestor exposes all its guides; a matching leaf exposes
        // only its ancestors. Keep each disclosure's original state for clear.
        const filterList = (list: HTMLUListElement, ancestorMatches = false): number => {
          let count = 0;
          for (const row of list.children) {
            if (!(row instanceof HTMLLIElement)) continue;
            const group = row.querySelector<HTMLDetailsElement>(':scope > details');
            let matches = 0;
            if (group) {
              const label = group.querySelector(':scope > summary')?.textContent || '';
              const groupMatches = ancestorMatches || Boolean(query && normalize(label).includes(query));
              const children = group.querySelector<HTMLUListElement>(':scope > ul');
              if (children) matches = filterList(children, groupMatches);
              group.open = query ? matches > 0 : (savedOpen.get(group) ?? group.open);
            } else {
              const link = row.querySelector<HTMLAnchorElement>(':scope > a');
              if (link && (!query || ancestorMatches || normalize(link.textContent || '').includes(query))) matches = 1;
            }
            row.hidden = matches === 0;
            count += matches;
          }
          return count;
        };
        const count = filterList(tree);
        status.textContent = query ? (count ? `${status.dataset.count} ${count}` : status.dataset.empty!) : '';
        if (!query) savedOpen.clear();
      }, options);
      clear.addEventListener('click', () => {
        input.value = '';
        input.dispatchEvent(new Event('input'));
        input.focus();
      }, options);
      // Phones keep one category and one subgroup per category expanded. Native
      // summary keyboard activation also emits click and uses the same logic.
      this.addEventListener('click', (event) => {
        const summary = (event.target as Element).closest('.sidebar-section > summary, .sidebar-subgroup > summary');
        if (!summary || this.hasAttribute('data-filtering') || window.matchMedia('(min-width: 50rem)').matches) return;
        event.preventDefault();
        const selected = summary.parentElement as HTMLDetailsElement;
        const open = !selected.open;
        const peers = selected.classList.contains('sidebar-section')
          ? sections
          : [...selected.closest('.sidebar-section')!.querySelectorAll<HTMLDetailsElement>('.sidebar-subgroup')];
        peers.forEach((group) => { group.open = group === selected && open; });
      }, options);
    }

    cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }
  customElements.define('orionis-sidebar', OrionisSidebar);
</script>
